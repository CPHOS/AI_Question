# ============================================================================
# CPhOS AI 命题系统 —— 环境变量配置
# ============================================================================
# 配置分两层：
#   1) 部署 / 基础设施 / 机密（本文件大部分）：始终通过 .env 管理。
#   2) 模型与服务商选择及其参数、流程开关：已迁移为**数据库内的可持久化设置**，
#      仅通过管理员 API 修改（见 /api/admin/llm/*）。本文件中「种子默认值」一节
#      的变量**只在数据库首次初始化时**作为初始记录写入，之后再改这些变量不会
#      生效——请改用管理员 API。
# ============================================================================


# ===== [种子] LLM 服务商（仅首次初始化时播种） =====
# 支持: openrouter | openai_compatible
LLM_PROVIDER=openrouter

# OpenRouter（默认服务商）
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>

# 通用 OpenAI 兼容 API（DeepSeek、本地部署等）：
# 将 LLM_PROVIDER 改为 openai_compatible 并填写以下两项
# LLM_API_KEY=<LLM_API_KEY>
# LLM_BASE_URL=https://api.deepseek.com/v1

# ===== [种子] 大模型（命题 / 验算 / 仲裁） =====
BIG_MODEL_NAME=google/gemini-2.5-pro-preview
BIG_MODEL_TEMPERATURE=0.7
BIG_MODEL_MAX_TOKENS=32768
ARBITER_MAX_TOKENS=4096
# 审核 / 仲裁类 Agent 的采样温度（确定性审核，默认 0.0）
REVIEW_TEMPERATURE=0.0

# ===== [种子] 小模型（仅格式化排版，不接触数学公式） =====
SMALL_MODEL_NAME=openai/gpt-4o-mini
SMALL_MODEL_TEMPERATURE=0.0
SMALL_MODEL_MAX_TOKENS=8192

# ===== [种子] 服务商通用参数 =====
MODEL_TIMEOUT=600
LLM_MAX_RETRIES=3
LLM_STREAMING=false

# ===== [种子] 流程 / 源材料 / 自动编译 / SSE（运行期可持久化设置） =====
MAX_RETRY_COUNT=3
SOURCE_MATERIAL_MAX_CHARS=60000
AUTO_COMPILE_FIGURES=true
AUTO_COMPILE_LATEX=false
# 单次 LaTeX / TikZ 编译子进程超时（秒）；复杂模板或大图可调高
LATEX_COMPILE_TIMEOUT=180
# LaTeX 编译后端：local（本机 subprocess）或 remote（独立编译服务，见 docs/latex-service-protocol.md）
LATEX_COMPILER_BACKEND=local
# 远程编译服务根 URL（LATEX_COMPILER_BACKEND=remote 时必填）
LATEX_SERVICE_BASE_URL=
# 远程编译服务 API Key（经 Authorization: Bearer 发送；服务端 /healthz 外均需鉴权）
LATEX_SERVICE_API_KEY=
# 远程编译作业状态轮询间隔（秒）
LATEX_SERVICE_POLL_INTERVAL=2.0
# 远程编译作业等待终态的客户端总截止（秒）
LATEX_SERVICE_MAX_WAIT=1200.0
# SSE 实时进度推送：轮询间隔与连接最长存活（秒）
SSE_POLL_INTERVAL=1.0
SSE_MAX_DURATION=1800.0


# ============================================================================
# 以下为始终通过 .env 管理的部署 / 基础设施 / 机密项
# ============================================================================

# ===== LaTeX 编译设置（宿主工具链） =====
LATEX_ENGINE=xelatex
# CPHOS_TEMPLATE_DIR=../CPHOS-Latex/theory

# ===== FormatChecker 格式检查工具（git submodule: external/FormatChecker） =====
# 克隆仓库后需执行 `git submodule update --init` 拉取该子模块。
# 在模板修正节点对最终 LaTeX 运行格式检查，反馈并入修正报告。
# FORMAT_CHECK_ENABLED=1
# 子模块目录（默认 external/FormatChecker）
# FORMAT_CHECK_DIR=external/FormatChecker
# 最低报告级别：info / warning / error
# FORMAT_CHECK_MIN_SEVERITY=warning
# 单次检查子进程超时（秒）
# FORMAT_CHECK_TIMEOUT=30

# ===== 输出配置 =====
# OUTPUT_DIR=output

# ===== API 后端服务 =====
# 监听地址与端口
API_HOST=0.0.0.0
API_PORT=8000
# 同时执行的生成任务上限（每个任务耗时数分钟，按机器与额度调整）
MAX_CONCURRENT_JOBS=1
# 用户 / token / 任务元数据 + LLM 设置的 SQLite 路径（相对路径按项目根目录解析）
DB_PATH=data/api.db
# 引导管理员 token：首次启动时若库内尚无 admin，则以其哈希写入。
# 请用随机长字符串，并通过其他安全渠道分发给管理员。留空则不创建引导管理员。
ADMIN_BOOTSTRAP_TOKEN=<ADMIN_BOOTSTRAP_TOKEN>
# 跨域来源（逗号分隔）。留空则不启用 CORS（推荐用 nginx 反代做同源部署）。
# 仅在前端不经反代、直接跨域访问后端时需要，例:
# CORS_ALLOW_ORIGINS=http://localhost:8080,https://dashboard.example.com
CORS_ALLOW_ORIGINS=
